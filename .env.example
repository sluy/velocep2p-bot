# =============================================================
# KAIZEN HOLDING — White-Label Base | Archivo de Configuración
# =============================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena cada variable con los valores de tu cliente
# 3. Nunca subas el .env real a Git
# =============================================================

# ─── IDENTIDAD DEL CLIENTE ────────────────────────────────────
CLIENT_NAME="Kaizen Holding"
CLIENT_SLUG="kaizenholding"

# ─── INFRAESTRUCTURA ──────────────────────────────────────────
POSTGRES_USER=p2p_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=p2p_core
DATABASE_URL=postgresql://p2p_admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/p2p_core
REDIS_URL=redis://redis:6379

# ─── SEGURIDAD ────────────────────────────────────────────────
# JWT secret para tokens de autenticación (mínimo 32 caracteres)
JWT_SECRET=CHANGE_ME_SUPER_SECRET_MINIMUM_32_CHARS
# Clave de cifrado para API keys guardadas en panel admin (exactamente 32 chars)
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_ENCRYPTION_KEY
# Contraseña de acceso básico al panel /admin
ADMIN_PASSWORD=admin147258

# ─── ADMIN DASHBOARD (Next.js) ────────────────────────────────
NEXT_PUBLIC_CLIENT_NAME="Kaizen Holding"
NEXT_PUBLIC_CLIENT_SLUG="kaizenholding"
NEXT_PUBLIC_SUPPORT_EMAIL="soporte@kaizenholding.com"
# Opciones: kaizenholding | wolfgangbot | frank | rafa
NEXT_PUBLIC_THEME=kaizenholding
# Opciones: (vacío = full) | p2p_only
NEXT_PUBLIC_CLIENT_MODE=
# URL del backend order-manager
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── ORDER MANAGER (NestJS) ───────────────────────────────────
PORT=3000
# Las API keys de Binance/Bybit se configuran desde el Panel Admin
# y se almacenan cifradas. También se pueden precargar aquí:
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ─── TELEGRAM BOT & NOTIFICACIONES ─────────────────────────────
TELEGRAM_BOT_TOKEN="8821890193:AAHFDj4Qldiys_v1rmTWxCpuoQP7IV--r3o"
# Puedes usar la versión corta (ej: -4451081803) o con prefijo (ej: -1004451081803), el sistema lo auto-normaliza
TELEGRAM_CHAT_ID="-1003818325167"
TELEGRAM_REPORTS_CHAT_ID="-1004359383403"
# Capital base del grid bot (en USDT)
GRID_CAPITAL=10000
GRID_LEVERAGE=3

# ─── MARKET SCANNER (Python/FastAPI) ──────────────────────────
SCANNER_PORT=8000
SCAN_INTERVAL_SECONDS=30

# ─── AUTO-PAY BOT (Módulo Adicional) ─────────────────────────
# Solo activo si se usa el perfil Docker: --profile optional
BANESCO_USER=
BANESCO_PASSWORD=
